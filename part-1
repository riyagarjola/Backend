app.js
const express=require('express');
const noteModel = require("./models/note.model")
const app = express();
app.use(express.json());   //req.body m data tb tk ni aata jb tk middleware use na kr lo 

app.post("/notes", async(req,res)=>{
const data =req.body
await noteModel.create({
title:data.title,
description: data.description
})
res.status(201).json({
message:"Note created"
})
})

app.get('/notes',async(req,res)=>{
//const notes = await noteModel.find()   //find array of object k form m data hoga [] ; agr no data toh empty data.  //findOne -> ek ko find krti h
const notes = awit noteModel.findOne({
title: :test_title"
})
res.status(200).json(notes){
message:"Notes fetched successfully",
notes:notes
})
});

app.delete("/notes/:id", async(req,res)=> {
const id=req.params.id
await noteModel.findOneAndDelete({
_id:id
})
res.status(200).json({
message:"Note deleted successfully"
})
})

app.patch("/notes/:id", async(req,res) => {
const id=req.params.id
const description = req.body.description

await noteModel.findOneAndUpdate({_id:id},{description:description})
res.status(200).json({
message:"Note updated successfully"
  })
})
module.exports=app

